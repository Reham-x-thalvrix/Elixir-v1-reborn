{
  "manifest_version": 3,
  "name": "Elixir V1",
  "version": "2.0.0",
  "description": "made by Thalvrix",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://discord.com/*", "*://*.discord.com/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core.js", "bg.gif"],
      "matches": ["*://discord.com/*", "*://*.discord.com/*"]
    }
  ]
}
